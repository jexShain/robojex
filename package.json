{
  "name": "robojex",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/ceo-core packages/takeoverd",
    "build:web": "cd packages/web && npx vite build",
    "electron:dev": "node scripts/dev-electron.mjs",
    "electron:start": "electron packages/electron/main.js",
    "electron:build": "npm run build && npm run build:web && electron-builder --config packages/electron/electron-builder.yml --publish never",
    "test": "vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "smoke:real": "node scripts/smoke-real.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@yao-pkg/pkg": "^6.22.0",
    "electron": "^43.4.1",
    "esbuild": "^0.28.2",
    "into-stream": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^2.0.0"
  },
  "overrides": {
    "into-stream": "^6.0.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "dompurify": "^3.4.14",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.33.0",
    "marked": "^18.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
